package [[ group_id ]].config;

import [[ group_id ]].result.BaseResult;

import java.util.stream.Collectors;

import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.validation.BindException;
import org.springframework.validation.FieldError;
import org.springframework.web.bind.MissingServletRequestParameterException;
import org.springframework.web.bind.annotation.ExceptionHandler;
import org.springframework.web.bind.annotation.RestControllerAdvice;
[[% if use_validation %]]
import javax.validation.ConstraintViolation;
import javax.validation.ConstraintViolationException;
[[% endif %]]

/**
 * 全局异常处理：HTTP 恒 200，统一 {@link BaseResult} 结构（ret=0 成功、非 0 失败），
 * ret 采用原 HTTP 状态码语义（400 参数/状态错误、500 系统异常），msg 为面向调用方的中文提示。
 */
@RestControllerAdvice
public class GlobalExceptionHandler {

    private static final Logger log = LoggerFactory.getLogger(GlobalExceptionHandler.class);

    /**
     * 业务/状态错误：Service 层守卫式校验（org.springframework.util.Assert）抛出的 IAE/ISE。
     */
    @ExceptionHandler({IllegalArgumentException.class, IllegalStateException.class})
    public BaseResult<Void> businessError(Exception e) {
        return BaseResult.fail(400, e.getMessage());
    }

    /**
     * 请求体校验失败（@Validated @RequestBody 触发；MethodArgumentNotValidException 为其子类）。
     */
    @ExceptionHandler(BindException.class)
    public BaseResult<Void> invalidBody(BindException e) {
        String msg = e.getBindingResult().getFieldErrors().stream()
                .map(FieldError::getDefaultMessage)
                .collect(Collectors.joining("；"));
        return BaseResult.fail(400, msg);
    }
[[% if use_validation %]]

    /**
     * GET 参数/路径变量校验失败（Controller 类级 @Validated 触发）。
     */
    @ExceptionHandler(ConstraintViolationException.class)
    public BaseResult<Void> invalidParam(ConstraintViolationException e) {
        String msg = e.getConstraintViolations().stream()
                .map(ConstraintViolation::getMessage)
                .collect(Collectors.joining("；"));
        return BaseResult.fail(400, msg);
    }
[[% endif %]]

    /**
     * 必填请求参数缺失（@RequestParam 缺参，发生在绑定阶段、先于校验）。
     */
    @ExceptionHandler(MissingServletRequestParameterException.class)
    public BaseResult<Void> missingParam(MissingServletRequestParameterException e) {
        return BaseResult.fail(400, "缺少必填参数: " + e.getParameterName());
    }

    /**
     * 兜底：未预期的系统异常，log.error 留痕。
     */
    @ExceptionHandler(Exception.class)
    public BaseResult<Void> unexpectedError(Exception e) {
        log.error("接口处理异常", e);
        return BaseResult.fail(500, "系统异常: " + e.getMessage());
    }
}
