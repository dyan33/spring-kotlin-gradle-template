package [[ group_id ]].result;

import java.util.List;
[[% if use_mybatis_plus %]]

import com.baomidou.mybatisplus.core.metadata.IPage;
import com.baomidou.mybatisplus.extension.plugins.pagination.Page;

import java.util.stream.Collectors;
[[% endif %]]
[[% if use_lombok %]]

import lombok.Data;
import lombok.EqualsAndHashCode;
[[% endif %]]

/**
 * 分页响应：data 固定为 PageVo 结构（current/size/pages/total/hasNext/records）。
 */
[[% if use_lombok %]]
@Data
@EqualsAndHashCode(callSuper = true)
[[% endif %]]
public class PageResult<T> extends BaseResult<PageResult.PageVo<T>> {

    /**
     * 基础工厂：手工分页参数组装（不依赖任何分页组件）。
     */
    public static <T> PageResult<T> success(List<T> records, long current, long size, long total) {
        PageResult<T> response = new PageResult<>();
        response.setRet(ResultEnum.SUCCESS.getCode());
        response.setMsg(ResultEnum.SUCCESS.getMsg());
        PageVo<T> page = new PageVo<>();
        page.setRecords(records);
        page.setCurrent(current);
        page.setSize(size);
        page.setTotal(total);
        page.setPages(size == 0 ? 0 : (total + size - 1) / size);
        page.setHasNext(current * size < total);
        response.setData(page);
        return response;
    }
[[% if use_mybatis_plus %]]

    /**
     * MyBatis-Plus Page 直接包装。
     */
    public static <T> PageResult<T> success(Page<T> source) {
        return success(source.getRecords(), source.getCurrent(), source.getSize(), source.getTotal());
    }

    /**
     * MyBatis-Plus IPage + 实体转 VO。
     */
    public static <T, R> PageResult<R> success(IPage<T> source, Transfer<T, R> transfer) {
        List<R> records = source.getRecords().stream().map(transfer::trans).collect(Collectors.toList());
        return success(records, source.getCurrent(), source.getSize(), source.getTotal());
    }

    /**
     * 实体 → VO 转换函数。
     */
    public interface Transfer<T, R> {

        R trans(T source);
    }
[[% endif %]]

    public static class PageVo<T> {

        private long current;
        private long size;
        private long pages;
        private long total;
        private boolean hasNext;
        private List<T> records;

        public long getCurrent() {
            return current;
        }

        public void setCurrent(long current) {
            this.current = current;
        }

        public long getSize() {
            return size;
        }

        public void setSize(long size) {
            this.size = size;
        }

        public long getPages() {
            return pages;
        }

        public void setPages(long pages) {
            this.pages = pages;
        }

        public long getTotal() {
            return total;
        }

        public void setTotal(long total) {
            this.total = total;
        }

        public boolean isHasNext() {
            return hasNext;
        }

        public void setHasNext(boolean hasNext) {
            this.hasNext = hasNext;
        }

        public List<T> getRecords() {
            return records;
        }

        public void setRecords(List<T> records) {
            this.records = records;
        }
    }
}
