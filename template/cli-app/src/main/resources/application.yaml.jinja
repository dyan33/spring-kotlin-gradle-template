spring:
  datasource:
    url: jdbc:mysql://localhost:3306/test?useSSL=false&useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
    username: test
    password: test
[[% if use_web %]]
  mvc:
    pathmatch:
      # springfox(knife4j) 在 Boot 2.6+ 必须用 AntPathMatcher，缺省启动报
      # documentationPluginsBootstrapper NullPointerException
      matching-strategy: ant_path_matcher
[[% endif %]]

retrofit:
  global-log:
    log-strategy: body

mybatis:
  configuration:
    log-impl: org.apache.ibatis.logging.stdout.StdOutImpl

app:
  properties:
    - table: table_name
      name: name
      public_key: public_key
      task_id: '30214'

